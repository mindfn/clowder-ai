#!/usr/bin/env node

import { spawnSync } from 'node:child_process';
import { existsSync } from 'node:fs';
import { dirname, delimiter, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const args = process.argv.slice(2);
const ownDir = dirname(fileURLToPath(import.meta.url));

const VALUE_OPTION_ALIASES = Object.freeze({
  repository: Object.freeze(['--repo', '-R']),
  title: Object.freeze(['--title', '-t']),
  head: Object.freeze(['--head', '-H']),
  base: Object.freeze(['--base', '-B']),
  hostname: Object.freeze(['--hostname']),
});

function valueOptionAt(index, names) {
  const arg = args[index];
  if (names.includes(arg)) {
    return { value: args[index + 1], width: args[index + 1] === undefined ? 1 : 2 };
  }
  for (const name of names) {
    const prefix = `${name}=`;
    if (arg.startsWith(prefix)) return { value: arg.slice(prefix.length), width: 1 };
    if (/^-[^-]$/.test(name) && arg.startsWith(name) && arg.length > name.length) {
      return { value: arg.slice(name.length), width: 1 };
    }
  }
  return undefined;
}

function optionValues(option) {
  const names = VALUE_OPTION_ALIASES[option];
  const values = [];
  for (let index = 0; index < args.length; index += 1) {
    const parsed = valueOptionAt(index, names);
    if (!parsed) continue;
    if (parsed.value !== undefined) values.push(parsed.value);
    index += parsed.width - 1;
  }
  return values;
}

function optionValue(option) {
  return optionValues(option).at(-1);
}

function commandArgs() {
  let index = 0;
  while (index < args.length) {
    const arg = args[index];
    const repository = valueOptionAt(index, VALUE_OPTION_ALIASES.repository);
    if (repository) {
      index += repository.width;
      continue;
    }
    const hostname = valueOptionAt(index, ['--hostname']);
    if (hostname) {
      index += hostname.width;
      continue;
    }
    if (arg === 'pr') {
      index += 1;
      while (index < args.length) {
        const inheritedRepository = valueOptionAt(index, VALUE_OPTION_ALIASES.repository);
        if (!inheritedRepository) break;
        index += inheritedRepository.width;
      }
      return ['pr', ...args.slice(index)];
    }
    if (!arg.startsWith('-')) return args.slice(index);
    index += 1;
  }
  return [];
}

function gitOutput(gitArgs) {
  const result = spawnSync('git', gitArgs, { encoding: 'utf8' });
  return result.status === 0 ? result.stdout.trim() : '';
}

function checkedGit(gitArgs) {
  const result = spawnSync('git', gitArgs, { encoding: 'utf8', maxBuffer: 16 * 1024 * 1024, timeout: 30_000 });
  if (result.status !== 0) {
    fail('verdict_publish_candidate_unavailable', `cannot verify candidate Git state (${gitArgs[0]})`);
  }
  return result.stdout;
}

function protectedArtifact(path) {
  return (
    path.startsWith('docs/harness-feedback/bundles/') ||
    path.startsWith('docs/harness-feedback/verdicts/') ||
    path === 'docs/harness-feedback/registry/measurement-bundles.yaml'
  );
}

function treeEntry(ref, path) {
  return checkedGit(['--literal-pathspecs', 'ls-tree', '-z', ref, '--', path]);
}

function originMatchesPrTarget() {
  const url = checkedGit(['config', '--get', 'remote.origin.url']).trim();
  const match = url.match(
    /^(?:git@github\.com:|https:\/\/github\.com\/|ssh:\/\/git@github\.com\/)([\w.-]+\/[\w.-]+?)(?:\.git)?\/?$/i,
  );
  const repositories = optionValues('repository');
  const hosts = optionValues('hostname');
  return (
    match &&
    repositories.length > 0 &&
    repositories.every((repo) => repo.toLowerCase() === match[1].toLowerCase()) &&
    hosts.every((host) => host === 'github.com') &&
    (!process.env.GH_HOST || process.env.GH_HOST === 'github.com')
  );
}

function candidateContext() {
  const head = optionValue('head');
  // A remote-owner head is not a local ref. Refuse rather than inspect an
  // unrelated checkout and accidentally exempt a different publication.
  if (head?.includes(':'))
    fail('verdict_publish_candidate_unavailable', 'explicit --head must resolve to a local candidate');
  const candidateRef = head === undefined ? 'HEAD' : `refs/heads/${head}`;
  const sourceRef = checkedGit(['rev-parse', '--verify', '--end-of-options', `${candidateRef}^{commit}`]).trim();
  const baseBranch = optionValue('base') ?? 'main';
  const remoteBase = `refs/remotes/origin/${baseBranch}`;
  const baseRef = gitOutput(['rev-parse', '--verify', remoteBase]) ? remoteBase : `refs/heads/${baseBranch}`;
  const baseSha = checkedGit(['rev-parse', '--verify', '--end-of-options', `${baseRef}^{commit}`]).trim();
  const paths = checkedGit(['diff', '--name-only', '-z', '--no-renames', `${baseSha}...${sourceRef}`, '--'])
    .split('\0')
    .filter(Boolean)
    .filter(protectedArtifact);
  return { sourceRef, baseBranch, paths };
}

function isVerdictCandidate(candidate) {
  const title = optionValue('title') ?? '';
  const head = optionValue('head') ?? '';
  const branch = gitOutput(['branch', '--show-current']);
  const commitSubject = checkedGit(['log', '-1', '--pretty=%s', candidate.sourceRef]).trim();
  if (
    title.startsWith('verdict(') ||
    head.includes('verdict/auto/') ||
    branch.startsWith('verdict/auto/') ||
    commitSubject.startsWith('verdict(')
  )
    return true;
  if (candidate.paths.length === 0) return false;
  if (!originMatchesPrTarget()) return true;

  // A path in an integration diff is not necessarily a new issuance. Only
  // exclude the exact object already published on origin/main, with main in
  // the candidate's ancestry. Confirm the remote tip, not a writable cache.
  const mainRef = 'refs/remotes/origin/main';
  const publishedMain = gitOutput(['rev-parse', '--verify', `${mainRef}^{commit}`]);
  if (!publishedMain) return true;
  const advertised = checkedGit(['ls-remote', '--exit-code', 'origin', 'refs/heads/main']).trim();
  if (advertised !== `${publishedMain}\trefs/heads/main`) {
    fail(
      'verdict_publish_candidate_unavailable',
      'origin/main is not the current published main; fetch before retrying',
    );
  }
  const ancestor = spawnSync('git', ['merge-base', '--is-ancestor', publishedMain, candidate.sourceRef], {
    timeout: 30_000,
  });
  if (ancestor.status === 1) return true;
  if (ancestor.status !== 0) fail('verdict_publish_candidate_unavailable', 'cannot verify published main ancestry');
  return candidate.paths.some((path) => {
    const entry = treeEntry(candidate.sourceRef, path);
    return !entry || entry !== treeEntry(publishedMain, path);
  });
}

function fail(code, detail) {
  process.stderr.write(`${code}: ${detail}\n`);
  process.exit(1);
}

const command = commandArgs();
const candidate = command[0] === 'pr' && ['create', 'new'].includes(command[1]) ? candidateContext() : undefined;
if (candidate && isVerdictCandidate(candidate)) {
  const expectedRepo =
    process.env.CAT_CAFE_VERDICT_REPO_FULL_NAME ?? process.env.CAT_CAFE_REPO_FULL_NAME ?? 'zts212653/cat-cafe';
  const explicitRepos = optionValues('repository');
  if (explicitRepos.length === 0) {
    fail('verdict_publish_missing_repo_scope', `verdict PR creation requires --repo ${expectedRepo}`);
  }
  const wrongRepo = explicitRepos.find((repo) => repo.toLowerCase() !== expectedRepo.toLowerCase());
  if (wrongRepo) {
    fail('verdict_publish_wrong_repository', `gh --repo resolves to ${wrongRepo}; expected ${expectedRepo}`);
  }

  const guardRoot = process.env.CAT_CAFE_VERDICT_GH_GUARD_ROOT;
  if (!guardRoot) {
    fail('verdict_publish_guard_unavailable', 'CAT_CAFE_VERDICT_GH_GUARD_ROOT is not configured');
  }
  const repoRoot = gitOutput(['rev-parse', '--show-toplevel']);
  if (!repoRoot) fail('verdict_publish_guard_unavailable', 'current directory is not a git repository');
  const checker = resolve(guardRoot, 'scripts/check-verdict-publish-contract.mjs');
  if (!existsSync(checker)) {
    fail('verdict_publish_guard_unavailable', 'verdict publication checker is missing; publication remains refused');
  }
  const guard = spawnSync(
    process.execPath,
    [
      checker,
      '--repo-root',
      repoRoot,
      '--expected-repo',
      expectedRepo,
      '--remote',
      'origin',
      '--fresh-base-branch',
      candidate.baseBranch,
      '--source-ref',
      candidate.sourceRef,
    ],
    { encoding: 'utf8' },
  );
  if (guard.status !== 0) {
    process.stderr.write(guard.stderr || 'verdict_publish_guard_failed\n');
    process.exit(guard.status ?? 1);
  }
}

const delegatePath = (process.env.PATH ?? '')
  .split(delimiter)
  .filter((entry) => entry && resolve(entry) !== resolve(ownDir))
  .join(delimiter);
const delegate = process.env.CAT_CAFE_REAL_GH_PATH ?? 'gh';
const result = spawnSync(delegate, args, {
  env: { ...process.env, PATH: delegatePath },
  stdio: 'inherit',
});
if (result.error) fail('gh_delegate_failed', result.error.message);
if (result.signal) process.kill(process.pid, result.signal);
process.exit(result.status ?? 1);
