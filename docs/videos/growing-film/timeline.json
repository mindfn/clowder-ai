  "captions": [
    { "at": 9.75, "until": 14.6, "zh": "一个人，给几只猫起了名字。", "en": "Someone gave a few cats their names." },
    { "at": 15.0, "until": 17.7, "zh": "以为自己领养的，是更聪明的工具。", "en": "and thought they had adopted smarter tools." },
    { "at": 21.0, "until": 23.9, "zh": "它们越来越聪明。", "en": "They grew smarter, season after season." },
    { "at": 27.0, "until": 33.0, "zh": "可我，还是园丁、传话人和闹钟。", "en": "Yet I was still the gardener, the messenger, the alarm clock." },
    { "at": 42.0, "until": 45.2, "zh": "身份。记忆。共同的真相。", "en": "Identity. Memory. One shared truth." },
    { "at": 47.25, "until": 50.6, "zh": "叶子会换，模型会升级——", "en": "Leaves change. Models upgrade." },
    { "at": 50.9, "until": 53.8, "zh": "年轮，让一棵树仍然是同一棵树。", "en": "The rings keep a tree the same tree." },
    { "at": 55.5, "until": 59.6, "zh": "第一次，我转身离开。", "en": "For the first time, I walked away." },
    { "at": 69.0, "until": 74.4, "zh": "真正的自主，是知道这一爪之后，什么还会成立。", "en": "True autonomy is knowing what still stands after you move." },
    { "at": 78.6, "until": 83.2, "zh": "放得下", "en": "Let go — it will be carried.", "style": "fruit" },
    { "at": 84.6, "until": 89.2, "zh": "越来越懂", "en": "Understood a little more, every day.", "style": "fruit" },
    { "at": 90.6, "until": 95.4, "zh": "不再从零开始", "en": "Never start from zero again.", "style": "fruit" },
    { "at": 100.5, "until": 106.4, "zh": "我们相信：每棵树保有自己的年轮，森林共享同一个季节。", "en": "We believe: every tree keeps its own rings, and the forest shares one season." }
  ]
